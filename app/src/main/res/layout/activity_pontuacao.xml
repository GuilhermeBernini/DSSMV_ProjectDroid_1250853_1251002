<?xml version="1.0" encoding="utf-8"?>
<!-- Ecrã de pontuação: fundo escuro igual ao ecrã inicial -->
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:background="#10121F"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".PontuacaoActivity">

    <!-- Título: "Pontuação" a meio da partida, "🏆 Ganhou o X!" no fim. Em cima e centrado. -->
    <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pontuação"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="16dp"
            android:layout_marginTop="92dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Tabela: o Java escreve aqui "1. Bernini  5 pts", uma linha por jogador. No centro do ecrã. -->
    <TextView
            android:id="@+id/tvTabela"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:lineSpacingExtra="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Botão: "PRÓXIMO JOGO" ou "VOLTAR AO INÍCIO" (o Java muda o texto). Em baixo e centrado. -->
    <Button
            android:id="@+id/btnProximo"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:text="PRÓXIMO JOGO"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#6C4DFF"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="64dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
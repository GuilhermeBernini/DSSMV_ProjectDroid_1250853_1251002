<?xml version="1.0" encoding="utf-8"?>
<!-- Ecrã todo: fundo azul, ocupa o ecrã inteiro (match_parent) -->
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:background="#1565C0"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ContarVibracoesActivity">

    <!-- Título: wrap_content = a caixa ajusta-se sozinha ao tamanho do texto.
         #FFFFFF = branco (#RRGGBB, FF = máximo). 36sp = tamanho da letra. bold = negrito.
         Constraints = "cordas": Top preso ao topo (a 92dp de margem); Start (esquerda) + End (direita)
         puxam para os dois lados, por isso fica centrado na horizontal. Sem Bottom, fica em cima. -->
    <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contar vibrações 📳"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_marginTop="92dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Mensagem do meio: instruções, "A vibrar..." e o resultado.
         Preso aos 4 lados (Top+Bottom e Start+End), por isso fica no centro do ecrã.
         gravity=center centra as linhas do texto. padding = espaço por dentro, à volta do texto. -->
    <TextView
            android:id="@+id/tvMensagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha os olhos, segura o telemóvel na mão e conta as vibrações!"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:gravity="center"
            android:padding="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Botão VIBRAR: começa a ronda. Preso em baixo (a 64dp) e centrado. Esconde-se enquanto vibra. -->
    <Button
            android:id="@+id/btnVibrar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIBRAR"
            android:backgroundTint="#10121F"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="64dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Caixa dos números (LinearLayout = caixa que arruma o que tem dentro em fila).
         gone = escondida, com tudo o que está dentro; o Java mostra-a quando as vibrações acabam.
         width match_parent = largura do ecrã todo (para os botões serem grandes); height wrap_content = só a altura das filas.
         vertical = as 2 filas ficam uma por baixo da outra.
         padding 24dp = espaço POR DENTRO da caixa (como o branco entre a moldura e a foto): os botões não colam às bordas. -->
    <LinearLayout
            android:id="@+id/layoutNumeros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="24dp"
            android:layout_marginBottom="40dp"
            app:layout_constraintBottom_toBottomOf="parent">

        <!-- 1.ª fila (horizontal = botões lado a lado): 3, 4, 5.
             width 0dp + weight 1 = "a fila decide a largura"; peso 1+1+1 = 3 partes iguais.
             margin 4dp = espaço POR FORA de cada botão (entre dois botões ficam 8dp). -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            <Button android:id="@+id/btn3" android:text="3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_margin="4dp" android:backgroundTint="#10121F" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btn4" android:text="4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_margin="4dp" android:backgroundTint="#10121F" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btn5" android:text="5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_margin="4dp" android:backgroundTint="#10121F" android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- 2.ª fila: 6, 7, 8 (igual à de cima) -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            <Button android:id="@+id/btn6" android:text="6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_margin="4dp" android:backgroundTint="#10121F" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btn7" android:text="7" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_margin="4dp" android:backgroundTint="#10121F" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btn8" android:text="8" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_margin="4dp" android:backgroundTint="#10121F" android:textColor="#FFFFFF"/>
        </LinearLayout>
    </LinearLayout>

    <!-- JOGAR OUTRA VEZ: escondido (gone) até ao fim da ronda. Mesmo sítio que o VIBRAR. -->
    <Button
            android:id="@+id/btnRepetir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JOGAR OUTRA VEZ"
            android:backgroundTint="#10121F"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:layout_marginBottom="64dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
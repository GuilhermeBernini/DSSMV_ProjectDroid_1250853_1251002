<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#10121F"
        tools:context=".MainActivity">

    <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SPINPARTY"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="bold"
            android:layout_marginTop="100dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Roda o telemóvel. Aceita o desafio.\nDescobre quem vai ganhar!"
            android:textColor="#C4C6D8"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <TextView
            android:id="@+id/tvIcon"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:text="↻"
            android:textColor="#FFFFFF"
            android:textSize="100sp"
            android:gravity="center"
            android:background="#6C4DFF"
            android:layout_marginTop="48dp"
            app:layout_constraintTop_toBottomOf="@id/tvDescription"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    <!-- Caixa do nome: ocupa a largura toda menos o botão + (fica presa ao btnAdicionar) -->
    <EditText
            android:id="@+id/etNomeJogador"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Nome do jogador"
            android:textColor="#FFFFFF"
            android:textColorHint="#8A8DA6"
            android:inputType="textPersonName"
            android:autofillHints="name"
            android:layout_marginStart="32dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/tvIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnAdicionar" />

    <!-- Botão +: junta o nome escrito à lista de jogadores -->
    <Button
            android:id="@+id/btnAdicionar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6C4DFF"
            android:layout_marginEnd="32dp"
            app:layout_constraintTop_toTopOf="@id/etNomeJogador"
            app:layout_constraintBottom_toBottomOf="@id/etNomeJogador"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- Lista dos jogadores já adicionados (o Java escreve aqui) -->
    <TextView
            android:id="@+id/tvJogadores"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Ainda não há jogadores"
            android:textColor="#C4C6D8"
            android:textSize="16sp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/etNomeJogador"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- COMEÇAR: agora fica por baixo da lista de jogadores -->
    <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:text="COMEÇAR A JOGAR"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#6C4DFF"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toTopOf="@id/btnRules"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    <Button
            android:id="@+id/btnRules"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:text="COMO JOGAR"
            android:textColor="#FFFFFF"
            android:backgroundTint="#292B40"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>